# Ghana Earth Intelligence -- environment template
# The app runs fine with NONE of this set (falls back to in-memory storage,
# no persistence). Set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY to enable
# real PostGIS persistence of alerts/verifications.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# --- Supabase / PostGIS (Phase 1 persistence, project: ghana-earth-intelligence) ---
# SUPABASE_URL and the anon key below are safe to commit -- every table has
# RLS enabled with a public-read-only policy (see the gei_rls_policies
# migration), so the anon key alone cannot write anything.
SUPABASE_URL=https://wicmmyajbeesodbhxmdm.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndpY21teWFqYmVlc29kYmh4bWRtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwMDE1MjIsImV4cCI6MjEwMzU3NzUyMn0.1maJ6IAjbON-ipHQQTKYd9uv1LpUCy2dI5A3CMFw1CA

# REQUIRED for the backend to actually WRITE alerts/verifications (RLS
# blocks writes from the anon key by design). Get this from the Supabase
# dashboard -> Settings -> API -> service_role, and set it only in your
# real environment (Render/Railway/local .env) -- NEVER commit a real
# value here, and never expose it to a browser/frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Reserved for later phases (not used by the MVP yet) ---
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=
# COPERNICUS_DATASPACE_USERNAME=
# COPERNICUS_DATASPACE_PASSWORD=
